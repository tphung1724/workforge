# ==========================================================
# EditorConfig
# https://editorconfig.org
# ==========================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false

# Java
[*.java]
indent_size = 4

# Kotlin
[*.kt]
indent_size = 4

# XML
[*.xml]
indent_size = 4

# YAML
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# JavaScript
[*.js]
indent_size = 2

# TypeScript
[*.ts]
indent_size = 2

# React
[*.tsx]
indent_size = 2

# CSS
[*.css]
indent_size = 2

# SCSS
[*.scss]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# Dockerfile
[Dockerfile]
indent_size = 4

# Shell
[*.sh]
indent_size = 2

# Properties
[*.properties]
indent_size = 2

# Gradle
[*.gradle]
indent_size = 4